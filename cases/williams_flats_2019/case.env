# Williams Flats fire, Washington, 3 Aug 2019 (SAM-ASP-TUV v1.0.0 case SND1, run SND1E1S1)
# docker|podman run --env-file cases/williams_flats_2019/case.env ... sam-asp-tuv  (default image; see README.md)
CASE=williamsflats2019
LAT=47.9392
LON=-118.6183
DATE=2019-08-03
START_TIME=19:36
RUN_HOURS=8
DT=10
MASSEMIS=8.3e-07
SAM_SET=perturb_type=2;bubble_x0=60000.;bubble_y0=0.;bubble_z0=1500.;bubble_radius_hor=1000.;bubble_radius_ver=100.;bubble_dtemp=10.;bubble_dq=0.
